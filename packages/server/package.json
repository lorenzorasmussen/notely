{
  "name": "@notely/server",
  "version": "1.0.0",
  "description": "Notely backend API server",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "better-sqlite3": "^12.2.0",
